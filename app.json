{
  "expo": {
    "name": "Vibra",
    "slug": "vibraunad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vibra",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.anonymous.Vibra"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./app/assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#FF6B35",
      "resizeMode": "contain"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://192.168.101.71:8081",
          "asyncRoutes": {
            "app": "./app/**/*.tsx"
          }
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vibra necesita acceso a tu galería para seleccionar una foto de perfil.",
          "cameraPermission": "Vibra necesita acceso a tu cámara para tomar una foto de perfil."
        }
      ]
    ],
    "experiments": {
      "newArchEnabled": true
    },
    "extra": {
      "router": {
        "origin": "https://app.vibraunad.com.co",
        "asyncRoutes": {
          "app": "./app/**/*.tsx"
        }
      },
      "eas": {
        "projectId": "5a52374a-7c54-4fd0-8f0c-6d60f3090f54"
      }
    },
    "owner": "desobsesor"
  }
}
